# =============================================================================
# Pelita configuration
#
# `make up` copies this file to .env on first run. .env is gitignored.
# Switching model provider means editing the three LLM_ lines below and nothing
# else — no code change, no vendor SDK.
# =============================================================================

# --- Model access ------------------------------------------------------------
# Defaults are OpenAI. See the README for Groq, Ollama, OpenRouter and vLLM.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

SYSTEM_PROMPT=You are Pelita, a helpful assistant. Answer clearly and concisely. If you are unsure about something, say so rather than guessing.

# --- Pricing -----------------------------------------------------------------
# Per one million tokens, in LLM_PRICE_CURRENCY. Defaults match gpt-4o-mini.
# Set both to 0 to hide cost while still counting tokens.
LLM_PRICE_INPUT_PER_1M=0.15
LLM_PRICE_OUTPUT_PER_1M=0.60
LLM_PRICE_CURRENCY=USD

# --- Context budgets (tokens) ------------------------------------------------
MEMORY_TOKEN_BUDGET=512
TOOLS_TOKEN_BUDGET=2048
HISTORY_TOKEN_BUDGET=4096
# Shared evenly across the files attached to a chat, and paid every turn.
DOCUMENTS_TOKEN_BUDGET=8192

# --- Database ----------------------------------------------------------------
# Under Docker these three drive the connection string; DATABASE_URL is derived
# from them in docker-compose.yml. Set DATABASE_URL directly only when running
# the API outside Docker.
POSTGRES_USER=pelita
POSTGRES_PASSWORD=pelita
POSTGRES_DB=pelita
POSTGRES_PORT=5433

# --- Ports -------------------------------------------------------------------
WEB_PORT=8080
API_PORT=8000

# --- Auth --------------------------------------------------------------------
# CHANGE JWT_SECRET BEFORE DEPLOYING ANYWHERE.
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# The seeded account exists so `make up` lands on a usable app.
# CHANGE THESE BEFORE DEPLOYING ANYWHERE.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@test.com

# --- Tools -------------------------------------------------------------------
# Web search is disabled in the UI when SERPAPI_KEY is empty. Get one at
# https://serpapi.com — the free tier is enough to try it.
SERPAPI_KEY=
SEARCH_MAX_RESULTS=5

# News strip. Any MCP server exposing a headlines tool works; point
# MCP_NEWS_COMMAND at it. If the server is unreachable the strip is hidden and
# chat is unaffected.
MCP_NEWS_COMMAND=/opt/mcp-news/bin/google-news-mcp
MCP_NEWS_TOOL=get_top_headlines
MCP_NEWS_LANGUAGE=en
MCP_NEWS_COUNTRY=US
MCP_NEWS_TTL_SECONDS=1800
MCP_NEWS_MAX_ITEMS=6

# --- Rate limiting -----------------------------------------------------------
# Per minute. 0 disables one limit; RATE_LIMIT_ENABLED=false disables all.
# Chat and upload count per user, auth counts per client address — the point of
# the auth limit is the requests made before anyone is signed in.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10

# nginx appends the real peer to any X-Forwarded-For the client sent, so the
# LAST entry is the trustworthy one. Set false if you expose the API directly:
# then the header is entirely client-controlled, and believing it lets anyone
# reset their own limit by inventing an address.
TRUST_PROXY_HEADERS=true

# --- Tool calling ------------------------------------------------------------
# The model is handed the tool list and chooses. Set false to pick a tool from
# the question with patterns instead — which is also what happens automatically
# when a provider rejects a `tools` payload, so search keeps working either way.
# Each iteration is another model call, so this is the cost ceiling too.
TOOL_CALLING_ENABLED=true
TOOL_MAX_ITERATIONS=3

# --- Attached files ----------------------------------------------------------
# Text, PDF and Word files attached to a chat. Raising DOCUMENT_MAX_BYTES means
# raising client_max_body_size in frontend/nginx.conf to match.
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_MAX_PER_CONVERSATION=3

# Reading uploaded images needs a model that can see, which is rarely the one
# that writes the answers. Leave VISION_MODEL empty and images are refused with
# a clear message — everything else still works. Set it (gpt-4o-mini,
# llama-3.2-11b-vision-preview, ilmu-vision-v1.3, llava) and the picker accepts
# images. The URL and key default to the LLM_ ones, so a single gateway serving
# both needs only this line.
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MAX_PIXELS=2500000

# --- Memory ------------------------------------------------------------------
MEMORY_AUTO_EXTRACT=true
MEMORY_MAX_PER_USER=100

# --- Suggestions -------------------------------------------------------------
SUGGESTIONS_ENABLED=true
SUGGESTIONS_COUNT=3

# --- Prompt injection guard --------------------------------------------------
GUARD_ENABLED=true

# --- Language ----------------------------------------------------------------
# Detected once from the first message; the reply follows it.
SUPPORTED_LANGUAGES=en,ms,ta,zh,bn
DEFAULT_LANGUAGE=en

# --- App ---------------------------------------------------------------------
APP_NAME=Pelita
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
